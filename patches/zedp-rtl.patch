+    fn persian_selection_and_caret_follow_directwrite() -> Result<()> {
+        use windows::Win32::Graphics::DirectWrite::DWRITE_HIT_TEST_METRICS;
+        let platform = Arc::new(DirectWriteTextSystem::new()?);
+        let system = WindowTextSystem::new(Arc::new(TextSystem::new(platform.clone())));
+        let font = Font {
+            family: "Segoe UI".into(),
+            ..Default::default()
+        };
+        let font_id = platform.font_id(&font)?;
+        let format = {
+            let state = platform.state.read();
+            let info = &state.fonts[font_id.0];
+            unsafe {
+                platform.components.factory.CreateTextFormat(
+                    &info.font_family_h,
+                    &info.font_collection,
+                    info.font_face.GetWeight(),
+                    info.font_face.GetStyle(),
+                    DWRITE_FONT_STRETCH_NORMAL,
+                    16.0,
+                    &platform.components.locale,
+                )?
+            }
+        };
+        for text in ["بپژ", "x (بپژ 12) z", "a\tبپژ\tb", "پژ س ۱۲"] {
+            let utf16 = text.encode_utf16().collect::<Vec<_>>();
+            let native = unsafe {
+                platform.components.factory.CreateTextLayout(
+                    &utf16,
+                    &format,
+                    f32::INFINITY,
+                    f32::INFINITY,
+                )?
+            };
+            let shaped = system.shape_line(
+                text.into(),
+                px(16.0),
+                &[TextRun {
+                    len: text.len(),
+                    font: font.clone(),
+                    ..Default::default()
+                }],
+                None,
+            );
+            assert!(shaped.runs.iter().any(|run| run.is_rtl));
+            let mut offset = 0;
+            for (byte, ch) in text.char_indices() {
+                let mut hit = DWRITE_HIT_TEST_METRICS::default();
+                let (mut x, mut y) = (0., 0.);
+                unsafe {
+                    native.HitTestTextPosition(offset, false, &mut x, &mut y, &mut hit)?;
+                }
+                let spans = shaped.visual_ranges_for_bytes(byte..byte + ch.len_utf8());
+                assert_eq!(spans.len(), 1, "{text:?} byte {byte}");
+                assert!(
+                    (spans[0].start - px(hit.left)).abs() < px(0.05),
+                    "{text:?} {ch} left {:?} != {}",
+                    spans[0].start,
+                    hit.left
+                );
+                assert!(
+                    (spans[0].end - px(hit.left + hit.width)).abs() < px(0.05),
+                    "{text:?} {ch} right"
+                );
+                // Inside a Persian run, both shaping engines must put the caret on its right edge.
+                if ch == 'پ' && byte > 0 && text[..byte].ends_with('ب') {
+                    assert!((shaped.x_for_index(byte) - px(x)).abs() < px(0.05));
+                    assert_eq!(shaped.closest_index_for_x(px(x - 0.01)), byte);
+                }
+                offset += ch.len_utf16() as u32;
+            }
+        }
+        Ok(())
+    }
