+    }
+
+    #[test]
+    fn test_caret_pure_rtl() {
+        // "سلام" (8 bytes, 10px glyphs, width 40), stored in visual order:
+        // م(6)@0, ا(4)@10, ل(2)@20, س(0)@30.
+        let layout = make_layout_runs(
+            vec![make_rtl_run(
+                0,
+                vec![
+                    glyph_at(0., 6),
+                    glyph_at(10., 4),
+                    glyph_at(20., 2),
+                    glyph_at(30., 0),
+                ],
+            )],
+            40.,
+            8,
+        );
+        // Caret at index 0 sits at the right edge, then at each glyph's left
+        // edge in descending-x order, ending at 0.
+        assert_eq!(f32::from(layout.x_for_index(0)), 40.);
+        assert_eq!(f32::from(layout.x_for_index(2)), 30.);
+        assert_eq!(f32::from(layout.x_for_index(4)), 20.);
+        assert_eq!(f32::from(layout.x_for_index(6)), 10.);
+        assert_eq!(f32::from(layout.x_for_index(8)), 0.);
+        // Clicking inside a glyph returns the caret just after it.
+        assert_eq!(layout.index_for_x(px(5.)), Some(8));
+        assert_eq!(layout.index_for_x(px(15.)), Some(6));
+        assert_eq!(layout.index_for_x(px(25.)), Some(4));
+        assert_eq!(layout.index_for_x(px(35.)), Some(2));
+        assert_eq!(layout.index_for_x(px(40.)), None);
+        // Goal-column resolution picks the nearest boundary.
+        assert_eq!(layout.closest_index_for_x(px(5.)), 8);
+        assert_eq!(layout.closest_index_for_x(px(14.)), 6);
+        assert_eq!(layout.closest_index_for_x(px(16.)), 4);
+        assert_eq!(layout.closest_index_for_x(px(39.)), 0);
+    }
+
+    #[test]
+    fn test_caret_ltr_then_rtl() {
+        // "abc سلام": LTR run [0,40), then RTL run [40,80); width 80.
+        let layout = make_layout_runs(
+            vec![
+                make_run(
+                    0,
+                    vec![
+                        glyph_at(0., 0),
+                        glyph_at(10., 1),
