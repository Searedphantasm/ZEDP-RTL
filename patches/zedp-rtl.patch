+    fn visual_clusters(&self) -> impl Iterator<Item = (&ShapedRun, &[ShapedGlyph], Range<Pixels>)> {
+        let mut clusters = self
+            .runs
+            .iter()
+            .flat_map(|run| {
+                run.glyphs
+                    .chunk_by(|a, b| a.index == b.index)
+                    .map(move |glyphs| (run, glyphs))
+            })
+            .peekable();
+        let mut left = Pixels::ZERO;
+        std::iter::from_fn(move || {
+            let (run, glyphs) = clusters.next()?;
+            let right = clusters
+                .peek()
+                .map_or(self.width, |(_, next)| next[0].position.x)
+                .max(left)
+                .min(self.width);
+            let cell = left..right;
+            left = right;
+            Some((run, glyphs, cell))
+        })
+    }
