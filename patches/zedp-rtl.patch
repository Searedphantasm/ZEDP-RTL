+    /// Visual intervals occupied by the selected source clusters in a bidirectional line.
+    pub fn visual_ranges_for_bytes(&self, bytes: Range<usize>) -> Vec<Range<Pixels>> {
+        let mut ranges: Vec<Range<Pixels>> = Vec::new();
+        if bytes.is_empty() || bytes.start >= self.len {
+            return ranges;
+        }
+        // A ligature or combining cluster may start before the selected byte.
+        let first = self
+            .runs
+            .iter()
+            .flat_map(|run| &run.glyphs)
+            .map(|g| g.index)
+            .filter(|index| *index <= bytes.start)
+            .max()
+            .unwrap_or(bytes.start);
+        for (_, glyphs, cell) in self.visual_clusters() {
+            if !(first..bytes.end).contains(&glyphs[0].index) || cell.is_empty() {
+                continue;
+            }
+            if let Some(last) = ranges.last_mut()
+                && last.end == cell.start
+            {
+                last.end = cell.end;
+            } else {
+                ranges.push(cell);
+            }
+        }
+        ranges
