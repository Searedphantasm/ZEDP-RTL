+        assert_eq!(f32::from(layout.x_for_index(2)), 30.);
+        assert_eq!(f32::from(layout.x_for_index(6)), 10.);
+        // Boundary at index 8: the LTR run's left edge wins the tie.
+        assert_eq!(f32::from(layout.x_for_index(8)), 40.);
+        assert_eq!(f32::from(layout.x_for_index(9)), 50.);
+        assert_eq!(f32::from(layout.x_for_index(14)), 100.);
+    }
