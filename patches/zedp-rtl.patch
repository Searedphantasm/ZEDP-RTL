+        assert_eq!(layout.index_for_x(px(25.)), Some(3));
+        assert_eq!(layout.index_for_x(px(30.)), None);
+        assert_eq!(layout.closest_index_for_x(px(5.)), 0);
+        assert_eq!(layout.closest_index_for_x(px(15.)), 1);
+        assert_eq!(layout.closest_index_for_x(px(25.)), 3);
+    }
