+            80.,
+            12,
+        );
+        assert_eq!(f32::from(layout.x_for_index(0)), 0.);
+        assert_eq!(f32::from(layout.x_for_index(3)), 30.);
+        // Run boundary: the LTR run's right edge wins.
+        assert_eq!(f32::from(layout.x_for_index(4)), 40.);
+        assert_eq!(f32::from(layout.x_for_index(6)), 70.);
+        assert_eq!(f32::from(layout.x_for_index(8)), 60.);
+        assert_eq!(f32::from(layout.x_for_index(10)), 50.);
+        assert_eq!(f32::from(layout.x_for_index(12)), 40.);
+    }
